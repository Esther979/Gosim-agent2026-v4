# Copy this file to .env and fill in an API key before running locally. Never commit
# .env or upload it in a submission ZIP -- the platform injects OPENAI_BASE_URL /
# OPENAI_API_KEY itself at run time, using its own model proxy and a temporary
# credential.
#
# Defaults to the Kimi Coding Plan (https://www.kimi.com/code/docs/en/):
#   OPENAI_BASE_URL  https://api.kimi.com/coding/v1 (mainland China) -- accounts outside
#                    mainland China should use https://api.kimi.ai/coding/v1 instead
#   OPENAI_MODEL     k3
# Any other OpenAI-compatible /chat/completions endpoint works too: just set
# OPENAI_BASE_URL / OPENAI_MODEL to override the defaults above.

OPENAI_BASE_URL=
OPENAI_MODEL=

# Required. KIMI_API_KEY is also accepted as an alternate name for the same value.
OPENAI_API_KEY=

# Configuration of branch merge/score-gain-pressure; matches observer.project.json.
# AGENT_SCORE_GAIN=1  value a target by predicted score minus the best score it already has
# AGENT_CONDITIONS    off | quality. "quality" swaps the learned sky scale for the fitted
#                     weather model (agent_core/conditions_config.json, read at start-up);
#                     off here: it lost in leave-one-card-out and costs about a third
#                     more CPU. The LLM call limits are left at the client defaults.
AGENT_CONDITIONS=off
AGENT_SCORE_GAIN=1

# Optional: path to a JSONL file the agent appends a decision trace to (night advice,
# the finish summary). Leave unset to disable; the write is best-effort and never
# crashes the agent if the path is not writable.
AGENT_TRACE_PATH=
