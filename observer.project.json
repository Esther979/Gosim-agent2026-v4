{
  "schema_version": "observer-project-v1",
  "protocol": "jsonl-v4",
  "image": "python:3.12-slim",
  "build": [],
  "run": [
    "python3",
    "-u",
    "agent.py"
  ],
  "working_directory": ".",
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "LLM_USER_AGENT": "Gosim-agent2026-v4/0.1 (GOSIM Agentic Observer hackathon agent; Python urllib)",
    "MERGE501_MODULES": "science_ev",
    "MERGE502_HORIZON": "1",
    "MERGE502_MISS_LLM": "1",
    "MERGE503_REQUIRED_GUARD": "1",
    "MERGE503_DUTY_LOG": "1",
    "MERGE510_NEIGHBOUR_SEARCH": "1"
  }
}
